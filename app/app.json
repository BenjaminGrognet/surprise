{
  "expo": {
    "name": "Secret Date",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-secretdate.png",
    "scheme": "secretdate",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/logo-secretdate.png",
      "bundleIdentifier": "fr.secretdate.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#040F0A",
        "foregroundImage": "./assets/images/logo-secretdate.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.secretdate.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-secretdate.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Secret Date dépose vos photos de soirée dans votre Livre des Secrets.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040F0A",
          "image": "./assets/images/splash-secretdate.png",
          "imageWidth": 540
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "fr.secretdate.app.widgets",
          "groupIdentifier": "group.fr.secretdate.app",
          "widgets": [
            {
              "name": "ProchaineSoiree",
              "displayName": "Prochaine soirée",
              "description": "Le compte à rebours et le dernier indice de votre soirée secrète.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/cormorant-garamond/500Medium_Italic/CormorantGaramond_500Medium_Italic.ttf",
            "./node_modules/@expo-google-fonts/manrope/400Regular/Manrope_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "ProchaineSoiree",
              "label": "Prochaine soirée",
              "description": "Le compte à rebours et le dernier indice de votre soirée secrète.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
