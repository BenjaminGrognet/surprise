{
  "expo": {
    "name": "Secret Date",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-secretdate.png",
    "scheme": "secretdate",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/logo-secretdate.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#082A1E",
        "foregroundImage": "./assets/images/logo-secretdate.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-secretdate.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Secret Date dépose vos photos de soirée dans votre Livre des Secrets.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#082A1E",
          "image": "./assets/images/splash-secretdate.png",
          "imageWidth": 540
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
