{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--env-file", ".env", "python", "-m", "surprise.admin", "--no-browser"],
      "port": 8000
    },
    {
      "name": "quiz",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--env-file", ".env", "python", "-m", "surprise.quiz", "--no-open"],
